Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", "=", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"func", "=", 
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", "z", "}"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Re", "[", "z", "]"}], ",", 
                  RowBox[{"Im", "[", "z", "]"}]}], "}"}], ",", 
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"expr1", "=", 
                    RowBox[{"PolyLog", "[", 
                    RowBox[{"2", ",", "z"}], "]"}]}], ",", 
                    RowBox[{"expr2", "=", 
                    RowBox[{"ReleaseHold", "@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Hold", "[", 
                    RowBox[{"PolyLog", "[", 
                    RowBox[{"2", ",", "z"}], "]"}], "]"}], "/.", 
                    RowBox[{"rule`Li2", "[", 
